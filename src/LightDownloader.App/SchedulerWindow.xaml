<Window x:Class="LightDownloader.App.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduler" Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource WindowStyle}">
    <StackPanel Margin="26,22,26,22">
        <DockPanel>
            <Border Width="42" Height="42" CornerRadius="11" Background="#1F2E57" Margin="0,0,14,0">
                <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="18"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Scheduler" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Start and pause all downloads at fixed times every day." FontSize="12"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <CheckBox x:Name="EnabledBox" Content="Enable the daily schedule" Margin="0,22,0,0" />
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="14" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Start all at" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="StartBox" ToolTip="24-hour time, e.g. 01:00" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Pause all at (optional)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="StopBox" ToolTip="24-hour time, e.g. 07:00" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Use 24-hour time (HH:mm). Leave a field empty to skip that action." FontSize="12"
                   Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="92" Click="OnCancel" />
            <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="110"
                    Margin="10,0,0,0" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
