<Window x:Class="LightDownloader.App.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduler" Width="400" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12">
        <GroupBox Header="Daily schedule" Padding="10,8">
            <StackPanel>
                <CheckBox x:Name="EnabledBox" Content="Start and stop all downloads at fixed times every day" />
                <Grid Margin="20,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Start downloads at" Style="{StaticResource Label}" />
                    <TextBox x:Name="StartBox" Grid.Column="1" Width="70" HorizontalAlignment="Left" ToolTip="24-hour time, e.g. 01:00" />
                    <TextBlock Grid.Row="1" Text="Stop downloads at" Style="{StaticResource Label}" Margin="0,8,10,0" />
                    <TextBox x:Name="StopBox" Grid.Row="1" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="0,8,0,0"
                             ToolTip="24-hour time, e.g. 07:00" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="20,10,0,0"
                           Text="24-hour time (HH:mm). Leave a time empty to skip it." />
            </StackPanel>
        </GroupBox>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorTextBrush}" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Style="{StaticResource DlgButton}" IsDefault="True" Click="OnSave" />
            <Button Content="Cancel" Style="{StaticResource DlgButton}" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
