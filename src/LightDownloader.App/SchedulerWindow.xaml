<Window x:Class="LightDownloader.App.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduler" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <CheckBox x:Name="EnabledBox" Content="Enable daily schedule" Margin="0,0,0,14" />

        <TextBlock Text="Start all downloads at (HH:mm)" />
        <TextBox x:Name="StartBox" Height="26" Margin="0,4,0,12" VerticalContentAlignment="Center" />

        <TextBlock Text="Pause all downloads at (HH:mm, optional)" />
        <TextBox x:Name="StopBox" Height="26" Margin="0,4,0,8" VerticalContentAlignment="Center" />

        <TextBlock Text="Leave a field empty to skip that action." Foreground="#666" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="96" Click="OnSave" IsDefault="True" />
            <Button Content="Cancel" Width="84" Margin="8,0,0,0" Click="OnCancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
