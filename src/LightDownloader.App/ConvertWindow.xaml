<Window x:Class="LightDownloader.App.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert" Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource WindowStyle}">
    <StackPanel Margin="26,22,26,22">
        <DockPanel>
            <Border Width="42" Height="42" CornerRadius="11" Background="#2E2550" Margin="0,0,14,0">
                <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="18"
                           Foreground="{StaticResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Convert" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Re-encode or remux the file with ffmpeg." FontSize="12"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBlock Text="Source" Style="{StaticResource FieldLabel}" Margin="0,20,0,6" />
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="11,8">
            <TextBlock x:Name="SourceText" TextTrimming="CharacterEllipsis" />
        </Border>

        <TextBlock Text="Convert to" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="FormatBox" SelectedIndex="0">
            <ComboBoxItem Content="MP4 — re-encode video (H.264)" />
            <ComboBoxItem Content="MKV — remux, no re-encode (fast)" />
            <ComboBoxItem Content="MP3 — audio only" />
            <ComboBoxItem Content="M4A — audio only (AAC)" />
            <ComboBoxItem Content="WAV — audio only, uncompressed" />
        </ComboBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="92" Click="OnCancel" />
            <Button Content="Convert" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="110"
                    Margin="10,0,0,0" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
