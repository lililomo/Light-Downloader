<Window x:Class="LightDownloader.App.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert" Height="210" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="Source" />
        <TextBlock x:Name="SourceText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,12" />
        <TextBlock Text="Convert to" />
        <ComboBox x:Name="FormatBox" Margin="0,4,0,0" SelectedIndex="0">
            <ComboBoxItem Content="MP4 (re-encode video)" />
            <ComboBoxItem Content="MKV (remux, no re-encode)" />
            <ComboBoxItem Content="MP3 (audio only)" />
            <ComboBoxItem Content="M4A (audio only)" />
            <ComboBoxItem Content="WAV (audio only)" />
        </ComboBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Convert" Width="96" Click="OnOk" IsDefault="True" />
            <Button Content="Cancel" Width="84" Margin="8,0,0,0" Click="OnCancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
