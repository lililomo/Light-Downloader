<Window x:Class="LightDownloader.App.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert" Width="420" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="File" Style="{StaticResource Label}" />
            <TextBlock x:Name="SourceText" Grid.Column="1" Style="{StaticResource Value}" />
            <TextBlock Grid.Row="1" Text="Convert to" Style="{StaticResource Label}" Margin="0,10,10,0" />
            <ComboBox x:Name="FormatBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="0,10,0,0">
                <ComboBoxItem Content="MP4 (H.264 video)" />
                <ComboBoxItem Content="MKV (same streams, fast)" />
                <ComboBoxItem Content="MP3 (audio only)" />
                <ComboBoxItem Content="M4A (AAC audio only)" />
                <ComboBoxItem Content="WAV (uncompressed audio)" />
            </ComboBox>
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="The converted file is saved next to the original, which is kept." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Convert" Style="{StaticResource DlgButton}" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" Style="{StaticResource DlgButton}" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
