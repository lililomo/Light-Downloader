<Window x:Class="LightDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightDownloader.App"
        Title="Light Downloader" Width="1240" Height="760" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterScreen" Style="{StaticResource WindowStyle}"
        Icon="pack://application:,,,/Assets/app.ico" PreviewKeyDown="OnWindowKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="NavTemplate">
            <Grid>
                <TextBlock Text="{Binding Label, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"
                           Visibility="{Binding IsHeader, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <Grid Visibility="{Binding IsHeader, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}"
                               FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Label, Mode=OneWay}" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Background="{StaticResource Surface3Brush}" CornerRadius="9" Padding="7,1" MinWidth="24">
                        <TextBlock Text="{Binding Count, Mode=OneWay}" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Brand -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                <Image Source="pack://application:,,,/Assets/logo-128.png" Width="32" Height="32"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Light Downloader" FontSize="14.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Text="v1.0" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="10,8">
            <!-- WrapPanel: on narrow (e.g. portrait) screens the buttons wrap instead of being clipped. -->
            <WrapPanel>
                <Button Style="{StaticResource ToolbarButton}" Content="Add URL" Click="OnAddUrl" ToolTip="Add a download by address (Ctrl+N)"
                        local:IconProps.Glyph="&#xE710;" local:IconProps.GlyphBrush="{StaticResource Accent2Brush}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Add video" Click="OnAddVideo" ToolTip="Grab a video from a page with yt-dlp"
                        local:IconProps.Glyph="&#xE714;" local:IconProps.GlyphBrush="{StaticResource VioletBrush}" />
                <Border Width="1" Margin="8,10" Background="{StaticResource BorderBrush}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Resume" Click="OnResume" ToolTip="Resume the selected downloads"
                        local:IconProps.Glyph="&#xE768;" local:IconProps.GlyphBrush="{StaticResource SuccessBrush}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Pause" Click="OnPause" ToolTip="Pause the selected downloads"
                        local:IconProps.Glyph="&#xE769;" local:IconProps.GlyphBrush="{StaticResource WarningBrush}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Pause all" Click="OnPauseAll" ToolTip="Pause every running download"
                        local:IconProps.Glyph="&#xE71A;" local:IconProps.GlyphBrush="{StaticResource DangerBrush}" />
                <Border Width="1" Margin="8,10" Background="{StaticResource BorderBrush}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Delete" Click="OnDelete" ToolTip="Remove the selected downloads (Del)"
                        local:IconProps.Glyph="&#xE74D;" local:IconProps.GlyphBrush="{StaticResource DangerBrush}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Clear done" Click="OnClearCompleted"
                        ToolTip="Remove finished downloads from the list (files are kept)"
                        local:IconProps.Glyph="&#xEA99;" local:IconProps.GlyphBrush="{StaticResource SubTextBrush}" />
                <Border Width="1" Margin="8,10" Background="{StaticResource BorderBrush}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Convert" Click="OnConvert" ToolTip="Convert a finished file with ffmpeg"
                        local:IconProps.Glyph="&#xE8AB;" local:IconProps.GlyphBrush="{StaticResource VioletBrush}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Scheduler" Click="OnScheduler" ToolTip="Start/pause downloads at set times"
                        local:IconProps.Glyph="&#xE787;" local:IconProps.GlyphBrush="{StaticResource AccentBrush}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Settings" Click="OnSettings" ToolTip="Settings"
                        local:IconProps.Glyph="&#xE713;" local:IconProps.GlyphBrush="{StaticResource SubTextBrush}" />
            </WrapPanel>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Margin="12" Padding="14,12" CornerRadius="10" Background="{StaticResource Surface2Brush}">
                    <StackPanel>
                        <TextBlock Text="CURRENT SPEED" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SpeedBig" Text="0 B/s" FontSize="20" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="SpeedSub" Text="No active downloads" FontSize="11.5"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <ListBox x:Name="NavList" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}"
                         ItemTemplate="{StaticResource NavTemplate}" Margin="0,10,0,0" SelectionChanged="OnNavChanged" />
            </DockPanel>
        </Border>

        <!-- List -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="22,14,16,10">
                <Grid DockPanel.Dock="Right" Width="270" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Padding="32,6,8,6" TextChanged="OnSearchChanged" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="Search downloads  (Ctrl+F)" Foreground="{StaticResource MutedBrush}" Margin="33,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ViewTitle" Text="All downloads" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="ViewCount" Text="0 items" Foreground="{StaticResource MutedBrush}"
                               Margin="10,5,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <DataGrid x:Name="DownloadsGrid" Grid.Row="1" Margin="10,0,10,0" RowHeight="52"
                      MouseDoubleClick="OnRowDoubleClick" PreviewMouseRightButtonDown="OnGridRightDown"
                      PreviewKeyDown="OnGridKeyDown" SizeChanged="OnGridSizeChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu Opened="OnRowMenuOpened">
                        <MenuItem x:Name="MiOpen" Header="Open" Click="OnOpenFile"
                                  local:IconProps.Glyph="&#xE8E5;" />
                        <MenuItem x:Name="MiFolder" Header="Open folder" Click="OnOpenFolder"
                                  local:IconProps.Glyph="&#xE838;" />
                        <MenuItem x:Name="MiProgress" Header="Show progress" Click="OnShowProgress" InputGestureText="Enter"
                                  local:IconProps.Glyph="&#xE946;" />
                        <Separator />
                        <MenuItem x:Name="MiResume" Header="Resume" Click="OnResume"
                                  local:IconProps.Glyph="&#xE768;" local:IconProps.GlyphBrush="{StaticResource SuccessBrush}" />
                        <MenuItem x:Name="MiPause" Header="Pause" Click="OnPause"
                                  local:IconProps.Glyph="&#xE769;" local:IconProps.GlyphBrush="{StaticResource WarningBrush}" />
                        <MenuItem x:Name="MiMove" Header="Change location…" Click="OnRelocate"
                                  local:IconProps.Glyph="&#xE8DE;" />
                        <MenuItem x:Name="MiCopy" Header="Copy address" Click="OnCopyUrl"
                                  local:IconProps.Glyph="&#xE8C8;" />
                        <MenuItem x:Name="MiConvert" Header="Convert…" Click="OnConvert"
                                  local:IconProps.Glyph="&#xE8AB;" local:IconProps.GlyphBrush="{StaticResource VioletBrush}" />
                        <Separator />
                        <MenuItem Header="Remove from list" Click="OnRemoveFromList" InputGestureText="Del"
                                  local:IconProps.Glyph="&#xE711;" />
                        <MenuItem Header="Delete file" Click="OnDeleteFile" InputGestureText="Shift+Del"
                                  local:IconProps.Glyph="&#xE74D;" local:IconProps.GlyphBrush="{StaticResource DangerBrush}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" MinWidth="220" SortMemberPath="FileName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="8"
                                            Background="{Binding Category, Mode=OneWay, Converter={StaticResource CategoryTint}}">
                                        <TextBlock Text="{Binding Category, Mode=OneWay, Converter={StaticResource CategoryGlyph}}"
                                                   Foreground="{Binding Category, Mode=OneWay, Converter={StaticResource CategoryBrush}}"
                                                   FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName, Mode=OneWay}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SubLine, Mode=OneWay}" FontSize="11.5" Margin="0,2,0,0"
                                                   Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Size" Width="150" SortMemberPath="TotalSize">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText, Mode=OneWay}" Foreground="{StaticResource SubTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Progress" Width="185" SortMemberPath="Progress">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <ProgressBar Style="{StaticResource RowProgress}" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" />
                                    <TextBlock Text="{Binding StatusLine, Mode=OneWay}" FontSize="11.5" Margin="0,5,0,0"
                                               Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Speed" Width="90" SortMemberPath="SpeedBytesPerSec">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SpeedText, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="EtaColumn" Header="Time left" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EtaText, Mode=OneWay}" Foreground="{StaticResource SubTextBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="AddedColumn" Header="Added" Width="115" SortMemberPath="AddedAt">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AddedAt, Mode=OneWay, StringFormat={}{0:dd MMM, HH:mm}}"
                                           Foreground="{StaticResource SubTextBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" IsHitTestVisible="False">
                <Border Width="76" Height="76" CornerRadius="20" Background="{StaticResource Surface2Brush}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="32"
                               Foreground="{StaticResource Accent2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EmptyTitle" Text="No downloads yet" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock x:Name="EmptyHint" Text="Click Add URL, or start a download in Chrome or Firefox."
                           Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,7">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="LimitText" Text="Speed limit: off" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                    <Border Width="1" Margin="12,2" Background="{StaticResource BorderBrush}" />
                    <TextBlock x:Name="ActiveText" Text="0 active" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="BridgeDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="BridgeText" Text="Browser bridge" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                    <Border Width="1" Margin="12,2" Background="{StaticResource BorderBrush}" />
                    <TextBlock x:Name="ToolsText" Text="Video tools" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
