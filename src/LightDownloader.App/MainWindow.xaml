<Window x:Class="LightDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightDownloader.App"
        Title="Light Downloader" Width="940" Height="560" MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/app.ico"
        Background="{x:Static SystemColors.ControlBrush}" FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        PreviewKeyDown="OnWindowKeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White">
            <MenuItem Header="_Tasks">
                <MenuItem Header="_Add new download..." InputGestureText="Ctrl+N" Click="OnAddUrl" />
                <MenuItem Header="Add _video download..." Click="OnAddVideo" />
                <Separator />
                <MenuItem Header="_Scheduler..." Click="OnScheduler" />
                <MenuItem Header="_Convert file..." Click="OnConvert" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_File" SubmenuOpened="OnFileMenuOpened">
                <MenuItem x:Name="MfOpen" Header="_Open" Click="OnOpenFile" />
                <MenuItem x:Name="MfFolder" Header="Open _folder" Click="OnOpenFolder" />
                <MenuItem x:Name="MfMove" Header="_Move/Rename..." Click="OnRelocate" />
                <MenuItem x:Name="MfCopy" Header="_Copy address" Click="OnCopyUrl" />
                <Separator />
                <MenuItem x:Name="MfRemove" Header="_Remove from list" InputGestureText="Del" Click="OnRemoveFromList" />
                <MenuItem x:Name="MfDelete" Header="_Delete file" InputGestureText="Shift+Del" Click="OnDeleteFile" />
            </MenuItem>
            <MenuItem Header="_Downloads">
                <MenuItem Header="_Resume" Click="OnResume" />
                <MenuItem Header="_Stop" Click="OnPause" />
                <MenuItem Header="Start a_ll" Click="OnStartAll" />
                <MenuItem Header="Stop _all" Click="OnPauseAll" />
                <Separator />
                <MenuItem Header="Delete _completed" Click="OnClearCompleted" />
                <Separator />
                <MenuItem Header="_Options..." Click="OnSettings" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="MvCategories" Header="_Categories" IsCheckable="True" IsChecked="True" Click="OnToggleCategories" />
                <MenuItem x:Name="MvToolbar" Header="_Toolbar" IsCheckable="True" IsChecked="True" Click="OnToggleToolbar" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Get the _Chrome extension" Click="OnChromeExtension" />
                <MenuItem Header="Get the _Firefox add-on" Click="OnFirefoxExtension" />
                <Separator />
                <MenuItem Header="Check for _updates..." Click="OnCheckUpdates" />
                <MenuItem Header="Light Downloader _website" Click="OnWebsite" />
                <MenuItem Header="_About Light Downloader" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <Border x:Name="ToolbarPanel" DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Padding="4,2">
            <!-- WrapPanel: on narrow screens the buttons wrap instead of being clipped. -->
            <WrapPanel>
                <Button Style="{StaticResource ToolButton}" Content="Add URL" Click="OnAddUrl" ToolTip="Add a download by address (Ctrl+N)"
                        local:IconProps.Glyph="&#xE710;" local:IconProps.GlyphBrush="{StaticResource IconBlue}" />
                <Button Style="{StaticResource ToolButton}" Content="Video" Click="OnAddVideo" ToolTip="Download a video from a web page"
                        local:IconProps.Glyph="&#xE714;" local:IconProps.GlyphBrush="{StaticResource IconPurple}" />
                <Border Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Content="Resume" Click="OnResume" ToolTip="Resume the selected downloads"
                        local:IconProps.Glyph="&#xE768;" local:IconProps.GlyphBrush="{StaticResource IconGreen}" />
                <Button Style="{StaticResource ToolButton}" Content="Stop" Click="OnPause" ToolTip="Stop the selected downloads (they can be resumed)"
                        local:IconProps.Glyph="&#xE769;" local:IconProps.GlyphBrush="{StaticResource IconOrange}" />
                <Button Style="{StaticResource ToolButton}" Content="Stop All" Click="OnPauseAll" ToolTip="Stop every running download"
                        local:IconProps.Glyph="&#xE71A;" local:IconProps.GlyphBrush="{StaticResource IconRed}" />
                <Border Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Content="Delete" Click="OnDelete" ToolTip="Delete the selected downloads (Del)"
                        local:IconProps.Glyph="&#xE74D;" local:IconProps.GlyphBrush="{StaticResource IconRed}" />
                <Button Style="{StaticResource ToolButton}" Content="Delete Completed" Click="OnClearCompleted"
                        ToolTip="Remove finished downloads from the list (the files stay on disk)"
                        local:IconProps.Glyph="&#xE73E;" local:IconProps.GlyphBrush="{StaticResource IconGray}" />
                <Border Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Content="Options" Click="OnSettings" ToolTip="Options"
                        local:IconProps.Glyph="&#xE713;" local:IconProps.GlyphBrush="{StaticResource IconGray}" />
                <Button Style="{StaticResource ToolButton}" Content="Scheduler" Click="OnScheduler" ToolTip="Start and stop downloads at set times"
                        local:IconProps.Glyph="&#xE823;" local:IconProps.GlyphBrush="{StaticResource IconBlue}" />
                <Button Style="{StaticResource ToolButton}" Content="Convert" Click="OnConvert" ToolTip="Convert a finished video or audio file"
                        local:IconProps.Glyph="&#xE8AB;" local:IconProps.GlyphBrush="{StaticResource IconTeal}" />
            </WrapPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{x:Static SystemColors.ControlBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem><TextBlock x:Name="CountText" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="SpeedText" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="LimitText" /></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToolsText" Margin="0,0,14,0" />
                    <TextBlock x:Name="BridgeText" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="190" MinWidth="120" />
                <ColumnDefinition x:Name="SplitColumn" Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="CategoriesPanel" Background="White">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="6,3,3,3"
                        Background="{StaticResource ToolbarBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0"
                                ToolTip="Hide categories" Click="OnToggleCategories" />
                        <TextBlock Text="Categories" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <TreeView x:Name="CategoryTree" BorderThickness="0" Padding="2,4" SelectedItemChanged="OnCategoryChanged" />
            </DockPanel>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{x:Static SystemColors.ControlBrush}" />

            <ListView x:Name="DownloadsList" Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{StaticResource LineBrush}"
                      Foreground="{x:Static SystemColors.WindowTextBrush}" SelectionMode="Extended" MouseDoubleClick="OnRowDoubleClick" KeyDown="OnListKeyDown"
                      GridViewColumnHeader.Click="OnColumnHeaderClick" ContextMenuOpening="OnRowMenuOpening"
                      VirtualizingPanel.IsVirtualizing="True">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="20" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="MiOpen" Header="_Open" FontWeight="SemiBold" Click="OnOpenFile" />
                        <MenuItem x:Name="MiFolder" Header="Open _folder" Click="OnOpenFolder" />
                        <Separator />
                        <MenuItem x:Name="MiResume" Header="_Resume" Click="OnResume" />
                        <MenuItem x:Name="MiPause" Header="_Stop" Click="OnPause" />
                        <MenuItem x:Name="MiProgress" Header="Show _progress" Click="OnShowProgress" />
                        <Separator />
                        <MenuItem x:Name="MiMove" Header="_Move/Rename..." Click="OnRelocate" />
                        <MenuItem x:Name="MiCopy" Header="_Copy address" Click="OnCopyUrl" />
                        <MenuItem x:Name="MiConvert" Header="Con_vert..." Click="OnConvert" />
                        <Separator />
                        <MenuItem Header="Re_move from list" InputGestureText="Del" Click="OnRemoveFromList" />
                        <MenuItem Header="_Delete file" InputGestureText="Shift+Del" Click="OnDeleteFile" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView AllowsColumnReorder="True">
                        <GridViewColumn Header="File Name" Width="290">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource FileIcon}">
                                                    <Binding Path="FileName" Mode="OneWay" />
                                                    <Binding Path="Kind" Mode="OneWay" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                        <TextBlock Text="{Binding FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath, Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding SizeShort, Mode=OneWay}" TextAlignment="Right" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Status" Width="86">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding StatusShort, Mode=OneWay}" ToolTip="{Binding StatusText, Mode=OneWay}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Time left" Width="70" DisplayMemberBinding="{Binding EtaShort, Mode=OneWay}" />
                        <GridViewColumn Header="Transfer rate" Width="90" DisplayMemberBinding="{Binding SpeedShort, Mode=OneWay}" />
                        <GridViewColumn Header="Last Try Date" Width="118" DisplayMemberBinding="{Binding LastTryText, Mode=OneWay}" />
                        <GridViewColumn Header="Address" Width="260" DisplayMemberBinding="{Binding Url, Mode=OneWay}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
