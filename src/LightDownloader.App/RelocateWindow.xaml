<Window x:Class="LightDownloader.App.RelocateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightDownloader.App"
        Title="Change location" Width="580" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource WindowStyle}">
    <StackPanel Margin="26,22,26,22">
        <TextBlock Text="Change location" FontSize="17" FontWeight="SemiBold" />
        <TextBlock x:Name="CurrentText" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />

        <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                    local:IconProps.Glyph="&#xE838;" ToolTip="Choose a folder" Click="OnBrowse" />
            <TextBox x:Name="FolderBox" />
        </DockPanel>

        <TextBlock Text="File name" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" />

        <TextBlock x:Name="NoteText" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,14,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="92" />
            <Button x:Name="MoveButton" Content="Move" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    MinWidth="110" Margin="10,0,0,0" Click="OnMove" />
        </StackPanel>
    </StackPanel>
</Window>
