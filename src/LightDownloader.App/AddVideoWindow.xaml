<Window x:Class="LightDownloader.App.AddVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add video" Height="200" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="Page or video URL" Margin="0,0,0,4" />
        <TextBox x:Name="UrlBox" Height="26" VerticalContentAlignment="Center" />
        <TextBlock Text="Video and audio are fetched with yt-dlp and merged into one MP4 with ffmpeg."
                   TextWrapping="Wrap" Foreground="#666" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Download" Width="96" Click="OnOk" IsDefault="True" />
            <Button Content="Cancel" Width="84" Margin="8,0,0,0" Click="OnCancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
