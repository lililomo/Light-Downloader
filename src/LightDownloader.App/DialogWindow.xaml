<Window x:Class="LightDownloader.App.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="420" MinHeight="140">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{x:Static SystemColors.ControlBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="12,11">
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Border>
        <Grid Background="White" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="IconImage" Width="32" Height="32" Margin="18,20,12,20" VerticalAlignment="Top" />
            <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" Margin="0,22,20,22" VerticalAlignment="Top" />
        </Grid>
    </DockPanel>
</Window>
