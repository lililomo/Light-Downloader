<Window x:Class="LightDownloader.App.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightDownloader.App"
        Title="Download" Width="640" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource WindowStyle}"
        Icon="pack://application:,,,/Assets/app.ico">
    <StackPanel Margin="26,22,26,20">
        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="TypeBadge" Width="48" Height="48" CornerRadius="12">
                <TextBlock x:Name="TypeGlyph" FontFamily="{StaticResource IconFont}" FontSize="22"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="UrlText" Margin="0,3,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Overall progress -->
        <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Connecting…" Margin="8,0,0,0" Foreground="{StaticResource SubTextBrush}" />
            </StackPanel>
            <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontSize="24" FontWeight="SemiBold" />
        </Grid>
        <ProgressBar x:Name="MainBar" Style="{StaticResource BigProgress}" Maximum="100" Margin="0,8,0,0" />

        <StackPanel x:Name="SegmentsPanel" Margin="0,12,0,0">
            <local:SegmentBar x:Name="Segments" Height="12" />
            <TextBlock x:Name="SegmentsCaption" Text="Each block is one connection" FontSize="11"
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>

        <!-- Stats -->
        <Border Margin="0,16,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="File size" Style="{StaticResource StatLabel}" />
                <TextBlock x:Name="SizeVal" Grid.Column="1" Style="{StaticResource StatValue}" />
                <TextBlock Grid.Column="3" Text="Transfer rate" Style="{StaticResource StatLabel}" />
                <TextBlock x:Name="RateVal" Grid.Column="4" Style="{StaticResource StatValue}" />

                <TextBlock Grid.Row="1" Text="Downloaded" Style="{StaticResource StatLabel}" />
                <TextBlock x:Name="DoneVal" Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Time left" Style="{StaticResource StatLabel}" />
                <TextBlock x:Name="EtaVal" Grid.Row="1" Grid.Column="4" Style="{StaticResource StatValue}" />

                <TextBlock Grid.Row="2" Text="Connections" Style="{StaticResource StatLabel}" />
                <TextBlock x:Name="ConnVal" Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValue}" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="Resume" Style="{StaticResource StatLabel}" />
                <TextBlock x:Name="ResumeVal" Grid.Row="2" Grid.Column="4" Style="{StaticResource StatValue}" />

                <TextBlock Grid.Row="3" Text="Save to" Style="{StaticResource StatLabel}" />
                <TextBlock x:Name="PathVal" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                           Style="{StaticResource StatValue}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- Per-download speed limit -->
        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <CheckBox x:Name="LimitBox" Content="Limit this download to" VerticalAlignment="Center"
                      Checked="OnLimitToggled" Unchecked="OnLimitToggled" />
            <TextBox x:Name="LimitValue" Width="84" Margin="12,0,0,0" Text="1024" />
            <TextBlock Text="KB/s" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
            <Button Content="Apply" Margin="10,0,0,0" Click="OnApplyLimit" />
        </DockPanel>

        <!-- Connection table -->
        <ToggleButton x:Name="DetailsToggle" Style="{StaticResource LinkToggle}" Content="Connection details"
                      Margin="0,16,0,0" HorizontalAlignment="Left" />
        <Border Margin="0,8,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="12,8"
                Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,4" TextElement.Foreground="{StaticResource MutedBrush}" TextElement.FontSize="11.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" />
                    <TextBlock Grid.Column="1" Text="Range" />
                    <TextBlock Grid.Column="2" Text="Received" />
                    <TextBlock Grid.Column="3" Text="Progress" />
                    <TextBlock Grid.Column="4" Text="Info" Margin="12,0,0,0" />
                </Grid>
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ConnList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Range, Mode=OneWay}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{Binding Received, Mode=OneWay}" FontSize="12" />
                                    <ProgressBar Grid.Column="3" Value="{Binding Percent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding Info, Mode=OneWay}" FontSize="12"
                                               Foreground="{StaticResource SubTextBrush}" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Outcome banners -->
        <Border x:Name="DonePanel" Visibility="Collapsed" Margin="0,16,0,0" Background="#162A20"
                BorderBrush="#245A3C" BorderThickness="1" CornerRadius="10" Padding="14,12">
            <DockPanel>
                <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="22"
                           Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="Download complete" FontWeight="SemiBold" />
                    <TextBlock x:Name="DoneInfo" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,16,0,0" Background="#2C1717"
                BorderBrush="#5E2626" BorderThickness="1" CornerRadius="10" Padding="14,12">
            <DockPanel>
                <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="20"
                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top" />
                <TextBlock x:Name="ErrorText" Margin="12,0,0,0" TextWrapping="Wrap" Foreground="#FFC2C2" />
            </DockPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Margin="0,20,0,0">
            <CheckBox x:Name="AutoCloseBox" Content="Close when finished" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenFolderButton" Content="Open folder" Click="OnOpenFolder" />
                <Button x:Name="CancelButton" Content="Cancel" Margin="10,0,0,0" MinWidth="88" Click="OnCancel"
                        ToolTip="Stop this download and close" />
                <Button x:Name="PauseButton" Content="Pause" Margin="10,0,0,0" MinWidth="104"
                        Style="{StaticResource PrimaryButton}" Click="OnPauseResume" />
                <Button x:Name="OpenFileButton" Content="Open" Margin="10,0,0,0" MinWidth="104" Visibility="Collapsed"
                        Style="{StaticResource PrimaryButton}" Click="OnOpenFile" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
