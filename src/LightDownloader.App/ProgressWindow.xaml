<Window x:Class="LightDownloader.App.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightDownloader.App"
        Title="Light Downloader" Width="500" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/app.ico"
        Background="{x:Static SystemColors.ControlBrush}" FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <StackPanel Margin="9">
        <TabControl>
            <TabItem Header="Download status">
                <StackPanel Margin="10,10,10,8">
                    <DockPanel>
                        <Image x:Name="TypeIcon" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock x:Name="UrlText" Foreground="{StaticResource LinkBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="StatusText" Margin="0,5,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="File size" Style="{StaticResource Label}" />
                        <TextBlock x:Name="SizeVal" Grid.Column="1" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="1" Text="Downloaded" Style="{StaticResource Label}" />
                        <TextBlock x:Name="DoneVal" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="2" Text="Transfer rate" Style="{StaticResource Label}" />
                        <TextBlock x:Name="RateVal" Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="3" Text="Time left" Style="{StaticResource Label}" />
                        <TextBlock x:Name="EtaVal" Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="4" Text="Resume capability" Style="{StaticResource Label}" />
                        <TextBlock x:Name="ResumeVal" Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="5" Text="Save to" Style="{StaticResource Label}" />
                        <TextBlock x:Name="PathVal" Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}" />
                    </Grid>
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Speed Limiter">
                <StackPanel Margin="12">
                    <CheckBox x:Name="LimitBox" Content="Use speed limiter" Checked="OnLimitToggled" Unchecked="OnLimitToggled" />
                    <StackPanel Orientation="Horizontal" Margin="20,10,0,0">
                        <TextBlock Text="Maximum download speed" Style="{StaticResource Label}" />
                        <TextBox x:Name="LimitValue" Width="70" Text="500" />
                        <TextBlock Text="KB/sec" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <Button Content="Apply" Style="{StaticResource DlgButton}" Margin="10,0,0,0" Click="OnApplyLimit" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="20,10,0,0"
                               Text="Applies to this download only, on top of the limit in Options." />
                </StackPanel>
            </TabItem>
            <TabItem Header="Options on completion">
                <StackPanel Margin="12">
                    <CheckBox x:Name="AutoCloseBox" Content="Close this window when the download finishes" />
                    <CheckBox x:Name="OpenFolderBox" Content="Open the folder when the download finishes" Margin="0,8,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <ProgressBar x:Name="MainBar" Height="18" Margin="0,9,0,0" Maximum="100" />

        <DockPanel Margin="0,9,0,0" LastChildFill="False">
            <Button x:Name="DetailsButton" DockPanel.Dock="Left" Content="&lt;&lt; Hide details" Style="{StaticResource DlgButton}" Margin="0"
                    Click="OnToggleDetails" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource DlgButton}" Click="OnCancel" />
            <Button x:Name="PauseButton" DockPanel.Dock="Right" Content="Pause" Style="{StaticResource DlgButton}" Click="OnPauseResume" />
            <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Content="Open folder" Style="{StaticResource DlgButton}" Click="OnOpenFolder" />
            <Button x:Name="OpenFileButton" DockPanel.Dock="Right" Content="Open" Style="{StaticResource DlgButton}" Click="OnOpenFile" IsDefault="True" />
        </DockPanel>

        <StackPanel x:Name="DetailsPanel" Margin="0,12,0,0">
            <TextBlock Text="Start positions and download progress by connections" />
            <Border BorderBrush="#FFA0A0A0" BorderThickness="1" Height="16" Margin="0,5,0,0" Background="White">
                <local:SegmentBar x:Name="Segments" />
            </Border>
            <ListView x:Name="ConnList" Height="128" Margin="0,9,0,0" Foreground="{x:Static SystemColors.WindowTextBrush}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="N." Width="36" DisplayMemberBinding="{Binding Index, Mode=OneWay}" />
                        <GridViewColumn Header="Downloaded" Width="96" DisplayMemberBinding="{Binding Received, Mode=OneWay}" />
                        <GridViewColumn Header="Range" Width="170" DisplayMemberBinding="{Binding Range, Mode=OneWay}" />
                        <GridViewColumn Header="Info" Width="120" DisplayMemberBinding="{Binding Info, Mode=OneWay}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </StackPanel>
</Window>
