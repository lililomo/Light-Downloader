<Window x:Class="LightDownloader.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Light Downloader Options" Width="520" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TabControl Height="372">
            <TabItem Header="General">
                <StackPanel Margin="12">
                    <CheckBox x:Name="StartupBox" Content="Launch Light Downloader on startup" />
                    <CheckBox x:Name="MinimizedBox" Content="Start minimized to the notification area" Margin="0,7,0,0" />
                    <GroupBox Header="Browser integration" Margin="0,14,0,0" Padding="8,6">
                        <StackPanel>
                            <CheckBox x:Name="CaptureBox" Content="Capture downloads from browsers" Checked="OnCaptureToggled" Unchecked="OnCaptureToggled" />
                            <TextBlock Text="Capture downloads from the following browsers:" Margin="20,10,0,4" />
                            <Border Margin="20,0,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White" Padding="6,4">
                                <StackPanel x:Name="BrowsersPanel" />
                            </Border>
                            <CheckBox x:Name="VideoButtonBox" Content="Show the &quot;Download this video&quot; button on web players" Margin="0,10,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="Each browser needs the Light Downloader Integration extension." />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Chrome extension..." Style="{StaticResource DlgButton}" Margin="0" Click="OnChromeExtension" />
                                <Button Content="Firefox add-on..." Style="{StaticResource DlgButton}" Click="OnFirefoxExtension" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="File Types">
                <StackPanel Margin="12">
                    <TextBlock Text="Automatically start downloading the following file types:" />
                    <TextBox x:Name="TypesBox" Height="96" Margin="0,5,0,0" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="2" />
                    <Button Content="Default" Style="{StaticResource DlgButton}" HorizontalAlignment="Right" Margin="0,6,0,0" Click="OnDefaultTypes" />
                    <TextBlock Text="Don't start downloading automatically from the following sites:" Margin="0,8,0,0" />
                    <TextBox x:Name="SitesBox" Height="70" Margin="0,5,0,0" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="2" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Separate entries with spaces. R0* matches .r00, .r01 and so on; a site also covers its subdomains." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Connection">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Max. connections per download" Style="{StaticResource Label}" />
                    <ComboBox x:Name="ConnBox" Grid.Column="1" Width="80" HorizontalAlignment="Left" IsEditable="True">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>16</ComboBoxItem>
                        <ComboBoxItem>24</ComboBoxItem>
                        <ComboBoxItem>32</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Grid.Row="1" Text="Max. downloads at the same time" Style="{StaticResource Label}" Margin="0,10,10,0" />
                    <TextBox x:Name="ConcBox" Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    <CheckBox x:Name="SpeedLimitBox" Grid.Row="2" Content="Limit total download speed to" Margin="0,14,10,0"
                              Checked="OnSpeedLimitToggled" Unchecked="OnSpeedLimitToggled" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBox x:Name="SpeedBox" Width="80" />
                        <TextBlock Text="KB/sec" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Browser integration port" Style="{StaticResource Label}" Margin="0,14,10,0" />
                    <TextBox x:Name="PortBox" Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Change the port only if another program uses it (the extension tries ports 7414 to 7417). Takes effect after a restart." />
                </Grid>
            </TabItem>

            <TabItem Header="Save To">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Category" Style="{StaticResource Label}" />
                        <ComboBox x:Name="SaveCategoryBox" Width="170" SelectionChanged="OnSaveCategoryChanged" />
                    </StackPanel>
                    <TextBlock x:Name="SaveFolderLabel" Text="Default download folder:" Margin="0,14,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource DlgButton}" Click="OnBrowseFolder" />
                        <TextBox x:Name="SaveFolderBox" />
                    </DockPanel>
                    <Button x:Name="UseDefaultButton" Content="Use the default folder" Style="{StaticResource DlgButton}" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Click="OnUseDefaultFolder" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                               Text="Categories without their own folder save to the General folder. Ticking &quot;Remember this path&quot; in the download dialog also sets a category's folder." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Downloads">
                <StackPanel Margin="12">
                    <CheckBox x:Name="AskBox" Content="Show the start download dialog (choose where to save)" />
                    <CheckBox x:Name="ProgressBox" Content="Show the download progress dialog" Margin="0,8,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Style="{StaticResource DlgButton}" IsDefault="True" Click="OnSave" />
            <Button Content="Cancel" Style="{StaticResource DlgButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
