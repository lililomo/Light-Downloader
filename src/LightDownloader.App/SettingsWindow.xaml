<Window x:Class="LightDownloader.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Download folder" />
        <DockPanel Margin="0,4,0,12">
            <Button DockPanel.Dock="Right" Content="Browse…" Width="84" Margin="8,0,0,0" Click="OnBrowse" />
            <TextBox x:Name="FolderBox" Height="26" VerticalContentAlignment="Center" />
        </DockPanel>

        <TextBlock Text="Connections per download (1–32)" />
        <TextBox x:Name="ConnBox" Height="26" Margin="0,4,0,12" VerticalContentAlignment="Center" />

        <TextBlock Text="Max concurrent downloads (1–20)" />
        <TextBox x:Name="ConcBox" Height="26" Margin="0,4,0,12" VerticalContentAlignment="Center" />

        <TextBlock Text="Speed limit in KB/s (0 = unlimited)" />
        <TextBox x:Name="SpeedBox" Height="26" Margin="0,4,0,12" VerticalContentAlignment="Center" />

        <TextBlock Text="Browser bridge port" />
        <TextBox x:Name="PortBox" Height="26" Margin="0,4,0,12" VerticalContentAlignment="Center" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Save" Width="96" Click="OnSave" IsDefault="True" />
            <Button Content="Cancel" Width="84" Margin="8,0,0,0" Click="OnCancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
