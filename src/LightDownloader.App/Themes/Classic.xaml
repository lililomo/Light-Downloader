<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:LightDownloader.App">
    <!-- Plain Windows look: system controls (Aero2), Segoe UI 9 pt, light chrome. Only the
         toolbar buttons and a few colours are defined here; everything else is the stock theme. -->

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:FileIconConverter x:Key="FileIcon" />

    <SolidColorBrush x:Key="ToolbarBrush" Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="LineBrush" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="LinkBrush" Color="#FF0066CC" />
    <SolidColorBrush x:Key="HintBrush" Color="#FF5F5F5F" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="OkTextBrush" Color="#FF107C10" />

    <!-- Toolbar icon colours. -->
    <SolidColorBrush x:Key="IconBlue" Color="#FF0067C0" />
    <SolidColorBrush x:Key="IconGreen" Color="#FF138A36" />
    <SolidColorBrush x:Key="IconOrange" Color="#FFCA5010" />
    <SolidColorBrush x:Key="IconRed" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="IconPurple" Color="#FF7A3EB1" />
    <SolidColorBrush x:Key="IconTeal" Color="#FF00838F" />
    <SolidColorBrush x:Key="IconGray" Color="#FF555555" />

    <!-- Big toolbar button: icon over a short label, like IDM's toolbar. -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Width" Value="66" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding (local:IconProps.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{Binding (local:IconProps.GlyphBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource IconFont}" FontSize="24" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="11" Margin="2,4,2,0" HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="#FF1B1B1B" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE5F3FF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFCCE8FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFCCE8FF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF99D1FF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolSeparator" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="5,8" />
        <Setter Property="Background" Value="{StaticResource LineBrush}" />
    </Style>

    <!-- Standard dialog button size (75 × 23 DLU-ish, as in Win32 dialogs). -->
    <Style x:Key="DlgButton" TargetType="Button">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="7,0,0,0" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Height" Value="23" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="2,0" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="23" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="DialogWindow" TargetType="Window">
        <Setter Property="Background" Value="{x:Static SystemColors.ControlBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="SizeToContent" Value="Height" />
    </Style>
</ResourceDictionary>
