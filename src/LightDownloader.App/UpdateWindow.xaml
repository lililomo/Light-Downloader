<Window x:Class="LightDownloader.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Light Downloader Update" Width="470" Style="{StaticResource DialogWindow}"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{x:Static SystemColors.ControlBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="12,11">
            <DockPanel>
                <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="Skip this version" Style="{StaticResource DlgButton}" Margin="0"
                        Click="OnSkip" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="UpdateButton" Content="Update now" Style="{StaticResource DlgButton}" IsDefault="True" Click="OnUpdate" />
                    <Button x:Name="LaterButton" Content="Remind me later" Style="{StaticResource DlgButton}" IsCancel="True" Click="OnLater" />
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel Background="White">
            <DockPanel Margin="16,16,16,0">
                <Image Source="pack://application:,,,/Assets/logo-128.png" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel>
                    <TextBlock Text="A new version of Light Downloader is available." FontSize="13" FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="19" />
                            <RowDefinition Height="19" />
                            <RowDefinition Height="19" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Installed version" Style="{StaticResource Label}" />
                        <TextBlock x:Name="CurrentText" Grid.Column="1" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="New version" Style="{StaticResource Label}" />
                        <TextBlock x:Name="NewText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Text="Download size" Style="{StaticResource Label}" />
                        <TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </DockPanel>
            <StackPanel Margin="16,12,16,14">
                <TextBlock Text="What's new:" />
                <TextBox x:Name="NotesBox" Height="110" Margin="0,4,0,0" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="3" />
                <TextBlock x:Name="ActiveNote" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed"
                           Text="Downloads in progress will be stopped and can be resumed after the update." />
                <ProgressBar x:Name="Progress" Height="16" Margin="0,10,0,0" Maximum="100" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
