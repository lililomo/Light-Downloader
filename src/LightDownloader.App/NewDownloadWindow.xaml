<Window x:Class="LightDownloader.App.NewDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download File Info" Width="560" Style="{StaticResource DialogWindow}"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/app.ico">
    <StackPanel Margin="14,14,14,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="URL" Style="{StaticResource Label}" />
            <TextBox x:Name="UrlBox" Grid.Column="1" Grid.ColumnSpan="2" TextChanged="OnUrlChanged" />

            <TextBlock Grid.Row="1" Text="Category" Style="{StaticResource Label}" Margin="0,9,10,0" />
            <ComboBox x:Name="CategoryBox" Grid.Row="1" Grid.Column="1" Width="170" HorizontalAlignment="Left" Margin="0,9,0,0"
                      SelectionChanged="OnCategoryChanged" />

            <TextBlock x:Name="PathLabel" Grid.Row="2" Text="Save As" Style="{StaticResource Label}" Margin="0,9,10,0" />
            <TextBox x:Name="PathBox" Grid.Row="2" Grid.Column="1" Margin="0,9,0,0" TextChanged="OnPathChanged" />
            <Button Grid.Row="2" Grid.Column="2" Content="..." Width="30" Height="23" Margin="5,9,0,0" Click="OnBrowse"
                    ToolTip="Choose where to save" />

            <TextBlock x:Name="QualityLabel" Grid.Row="3" Text="Quality" Style="{StaticResource Label}" Margin="0,9,10,0" />
            <ComboBox x:Name="QualityBox" Grid.Row="3" Grid.Column="1" Width="230" HorizontalAlignment="Left" Margin="0,9,0,0"
                      DisplayMemberPath="Label" SelectedValuePath="Id" />

            <CheckBox x:Name="RememberBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" />
        </Grid>

        <TextBlock x:Name="WarnText" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="72,8,0,0" Visibility="Collapsed" />

        <DockPanel Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Bottom">
                <Button x:Name="StartButton" Content="Start Download" Style="{StaticResource DlgButton}" IsDefault="True" Click="OnStart" />
                <Button x:Name="LaterButton" Content="Download Later" Style="{StaticResource DlgButton}" Click="OnLater" />
                <Button Content="Cancel" Style="{StaticResource DlgButton}" IsCancel="True" Click="OnCancel" />
            </StackPanel>
            <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <Image x:Name="TypeIcon" Width="32" Height="32" Margin="0,0,10,0" />
                <TextBlock x:Name="InfoText" VerticalAlignment="Center" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DockPanel>
    </StackPanel>
</Window>
