<Window x:Class="LightDownloader.App.AddUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add URL" Height="210" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="URL" Margin="0,0,0,4" />
        <TextBox x:Name="UrlBox" Height="26" VerticalContentAlignment="Center" />
        <TextBlock Text="File name (optional)" Margin="0,12,0,4" />
        <TextBox x:Name="NameBox" Height="26" VerticalContentAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Download" Width="96" Click="OnOk" IsDefault="True" />
            <Button Content="Cancel" Width="84" Margin="8,0,0,0" Click="OnCancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
